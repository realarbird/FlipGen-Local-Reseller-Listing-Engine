rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny All by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Per-User Secure Workspace Isolation
    // Only the authenticated user can read, create, update, or delete their own documents.
    // Completely prevents any cross-user data access, data leaks, or tampering.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
