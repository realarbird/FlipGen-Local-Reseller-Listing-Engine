VITE_FIREBASE_AUTH_DOMAIN=flipgen-reseller-engine.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flipgen-reseller-engine
VITE_FIREBASE_STORAGE_BUCKET=flipgen-reseller-engine.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=723388573425
VITE_FIREBASE_APP_ID=1:723388573425:web:2cb0fe5dfd9cafe2c32b50
VITE_FIREBASE_MEASUREMENT_ID=G-0KMPC2VW3M

# Local Ollama Host Configuration (Defaults to http://localhost:11434)
VITE_OLLAMA_BASE_URL=http://localhost:11434
